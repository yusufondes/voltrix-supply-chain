table '_KPI Measures'
	lineageTag: 7b1e0a90-5c44-4d21-9f0e-a1b2c3d4e501

	measure 'As Of DateKey' = CALCULATE ( MAX ( FactInventorySnapshot[DateKey] ), ALL ( DimDate ) )
		formatString: 0
		lineageTag: 30637013-6247-45f3-9272-761f24615541

	measure 'Ordered Qty' = SUM ( FactSalesOrderLine[OrderedQuantity] )
		formatString: #,0
		lineageTag: 3bfd5e58-2a61-4d70-9a77-309b08ffb3cb

	measure 'Delivered Qty' = SUM ( FactSalesOrderLine[DeliveredQty] )
		formatString: #,0
		lineageTag: ddf99e12-10c4-49b4-81a7-c4b4046254f4

	measure 'Backorder Qty' = SUM ( FactSalesOrderLine[BackorderQty] )
		formatString: #,0
		lineageTag: 167a29d9-fa8e-430a-9934-9215477d2783

	measure 'Delivered Revenue EUR' = SUM ( FactShipmentLine[DeliveredRevenueEUR] )
		formatString: #,0.00
		lineageTag: d291913f-8f2e-4880-9ce9-24cdd1567e5d

	measure 'Due Lines' =
			VAR AsOf = [As Of DateKey]
			RETURN
			    CALCULATE (
			        COUNTROWS ( FactSalesOrderLine ),
			        KEEPFILTERS ( FactSalesOrderLine[RequestedDateKey] <= AsOf )
			    )
		formatString: #,0
		lineageTag: 8f312caf-9ee7-4209-85d8-410d2f749a3f

	measure 'OTIF %' =
			VAR AsOf = [As Of DateKey]
			VAR DueL =
			    CALCULATE ( COUNTROWS ( FactSalesOrderLine ),
			        KEEPFILTERS ( FactSalesOrderLine[RequestedDateKey] <= AsOf ) )
			VAR OtifL =
			    CALCULATE ( COUNTROWS ( FactSalesOrderLine ),
			        KEEPFILTERS ( FactSalesOrderLine[RequestedDateKey] <= AsOf ),
			        KEEPFILTERS ( FactSalesOrderLine[IsOTIF] = TRUE () ) )
			RETURN
			    DIVIDE ( OtifL, DueL ) * 100
		formatString: 0.0"%"
		lineageTag: cd696ef3-0433-4d5f-8f52-116b27b7c38e

	measure 'On-Time Delivery %' =
			VAR AsOf = [As Of DateKey]
			VAR DueL =
			    CALCULATE ( COUNTROWS ( FactSalesOrderLine ),
			        KEEPFILTERS ( FactSalesOrderLine[RequestedDateKey] <= AsOf ) )
			VAR OnTimeL =
			    CALCULATE ( COUNTROWS ( FactSalesOrderLine ),
			        KEEPFILTERS ( FactSalesOrderLine[RequestedDateKey] <= AsOf ),
			        KEEPFILTERS ( FactSalesOrderLine[IsOnTime] = TRUE () ) )
			RETURN
			    DIVIDE ( OnTimeL, DueL ) * 100
		formatString: 0.0"%"
		lineageTag: feee3d8b-2c39-489a-be68-ee6df762e48b

	measure 'In-Full %' =
			VAR AsOf = [As Of DateKey]
			VAR DueL =
			    CALCULATE ( COUNTROWS ( FactSalesOrderLine ),
			        KEEPFILTERS ( FactSalesOrderLine[RequestedDateKey] <= AsOf ) )
			VAR InFullL =
			    CALCULATE ( COUNTROWS ( FactSalesOrderLine ),
			        KEEPFILTERS ( FactSalesOrderLine[RequestedDateKey] <= AsOf ),
			        KEEPFILTERS ( FactSalesOrderLine[IsInFull] = TRUE () ) )
			RETURN
			    DIVIDE ( InFullL, DueL ) * 100
		formatString: 0.0"%"
		lineageTag: bac858f9-9981-43d7-86ad-b426d738cbe8

	measure 'Fill Rate %' =
			
			VAR AsOfKey = [As Of DateKey]
			VAR DeliveredQ =
			    CALCULATE (
			        SUM ( FactSalesOrderLine[DeliveredQty] ),
			        KEEPFILTERS ( FactSalesOrderLine[RequestedDateKey] <= AsOfKey )
			    )
			VAR OrderedQ =
			    CALCULATE (
			        SUM ( FactSalesOrderLine[OrderedQuantity] ),
			        KEEPFILTERS ( FactSalesOrderLine[RequestedDateKey] <= AsOfKey )
			    )
			RETURN
			    DIVIDE ( DeliveredQ, OrderedQ ) * 100
		formatString: 0.0"%"
		lineageTag: 3c9b6e2d-d98d-4824-a609-e76222ed1aa9

	measure 'Late Order Lines' =
			VAR AsOf = [As Of DateKey]
			RETURN
			    CALCULATE (
			        COUNTROWS ( FactSalesOrderLine ),
			        KEEPFILTERS ( FactSalesOrderLine[RequestedDateKey] <= AsOf ),
			        KEEPFILTERS ( FactSalesOrderLine[IsOTIF] = FALSE () )
			    )
		formatString: #,0
		lineageTag: 71cde2f1-4734-4e57-9073-44bed696430c

	measure 'Open Order Lines' =
			CALCULATE (
			    COUNTROWS ( FactSalesOrderLine ),
			    KEEPFILTERS ( FactSalesOrderLine[IsOpen] = TRUE () )
			)
		formatString: #,0
		lineageTag: f3abf8dd-6957-42ba-b17f-30a353479ef9

	measure 'Due PO Lines' =
			VAR AsOf = [As Of DateKey]
			RETURN
			    CALCULATE (
			        COUNTROWS ( FactPurchaseOrderLine ),
			        KEEPFILTERS ( FactPurchaseOrderLine[ExpectedDeliveryDateKey] <= AsOf )
			    )
		formatString: #,0
		lineageTag: 000db17e-0930-4fea-bce0-08e06ac1ca53

	measure 'Supplier OTIF %' =
			VAR AsOf = [As Of DateKey]
			VAR DuePo =
			    CALCULATE ( COUNTROWS ( FactPurchaseOrderLine ),
			        KEEPFILTERS ( FactPurchaseOrderLine[ExpectedDeliveryDateKey] <= AsOf ) )
			VAR OtifPo =
			    CALCULATE ( COUNTROWS ( FactPurchaseOrderLine ),
			        KEEPFILTERS ( FactPurchaseOrderLine[ExpectedDeliveryDateKey] <= AsOf ),
			        KEEPFILTERS ( FactPurchaseOrderLine[IsSupplierOTIF] = TRUE () ) )
			RETURN
			    DIVIDE ( OtifPo, DuePo ) * 100
		formatString: 0.0"%"
		lineageTag: a0769825-9498-4bf0-89a9-ea5e344b72ef

	measure 'Supplier OTD %' =
			VAR AsOf = [As Of DateKey]
			VAR DuePo =
			    CALCULATE ( COUNTROWS ( FactPurchaseOrderLine ),
			        KEEPFILTERS ( FactPurchaseOrderLine[ExpectedDeliveryDateKey] <= AsOf ) )
			VAR OnTimePo =
			    CALCULATE ( COUNTROWS ( FactPurchaseOrderLine ),
			        KEEPFILTERS ( FactPurchaseOrderLine[ExpectedDeliveryDateKey] <= AsOf ),
			        KEEPFILTERS ( FactPurchaseOrderLine[IsSupplierOnTime] = TRUE () ) )
			RETURN
			    DIVIDE ( OnTimePo, DuePo ) * 100
		formatString: 0.0"%"
		lineageTag: f0bbe053-4af0-4f9a-9d4e-9a461dafdb24

	measure 'Open PO Lines' =
			COUNTROWS (
			    FILTER (
			        FactPurchaseOrderLine,
			        FactPurchaseOrderLine[AcceptedQty] < FactPurchaseOrderLine[OrderedQuantity]
			    )
			)
		formatString: #,0
		lineageTag: 16b9906d-e0f2-453c-8db5-17f80efec8e0

	measure 'Mean Lead Time (Days)' =
			AVERAGEX (
			    FactGoodsReceiptLine,
			    DATEDIFF (
			        LOOKUPVALUE (
			            FactPurchaseOrderLine[OrderDate],
			            FactPurchaseOrderLine[PurchaseOrderLineKey],
			            FactGoodsReceiptLine[PurchaseOrderLineKey]
			        ),
			        FactGoodsReceiptLine[ReceiptDate],
			        DAY
			    )
			)
		formatString: 0.0
		lineageTag: f61a8b0e-0ef9-43b0-98d6-0ab8e3630306

	measure 'Lead Time Std Dev (Days)' =
			STDEVX.S (
			    FactGoodsReceiptLine,
			    DATEDIFF (
			        LOOKUPVALUE (
			            FactPurchaseOrderLine[OrderDate],
			            FactPurchaseOrderLine[PurchaseOrderLineKey],
			            FactGoodsReceiptLine[PurchaseOrderLineKey]
			        ),
			        FactGoodsReceiptLine[ReceiptDate],
			        DAY
			    )
			)
		formatString: 0.0
		lineageTag: 5a51789d-cdbf-4943-b5bf-e8c4f29067e6

	measure 'Rejection Rate %' =
			DIVIDE (
			    SUM ( FactGoodsReceiptLine[RejectedQuantity] ),
			    SUM ( FactGoodsReceiptLine[ReceivedQuantity] )
			) * 100
		formatString: 0.00"%"
		lineageTag: 07a4061d-4884-4f5f-85e5-2a2c50b70f4e

	measure 'Ending Inventory (Units)' =
			CALCULATE (
			    CALCULATE (
			        SUM ( FactInventorySnapshot[ClosingQty] ),
			        LASTDATE ( DimDate[Date] )
			    ),
			    DimDate[IsTransactionHorizon] = TRUE ()
			)
		formatString: #,0
		lineageTag: d711bb2b-940e-4e8d-b78a-a31465ab8982

	measure 'Average Inventory (Units)' =
			CALCULATE (
			    AVERAGEX (
			        VALUES ( DimDate[Date] ),
			        CALCULATE ( SUM ( FactInventorySnapshot[ClosingQty] ) )
			    ),
			    DimDate[IsTransactionHorizon] = TRUE ()
			)
		formatString: #,0
		lineageTag: b41c5f7a-824b-4b23-8de9-070e94ef30af

	measure 'Inventory Value EUR' =
			CALCULATE (
			    CALCULATE (
			        SUM ( FactInventorySnapshot[ClosingValueEUR] ),
			        LASTDATE ( DimDate[Date] )
			    ),
			    DimDate[IsTransactionHorizon] = TRUE ()
			)
		formatString: €#,0
		lineageTag: 748b68d7-48cc-4072-a080-9f592d1221e5

	measure 'Average Inventory Value EUR' =
			CALCULATE (
			    AVERAGEX (
			        VALUES ( DimDate[Date] ),
			        CALCULATE ( SUM ( FactInventorySnapshot[ClosingValueEUR] ) )
			    ),
			    DimDate[IsTransactionHorizon] = TRUE ()
			)
		formatString: €#,0
		lineageTag: b52ca937-86f7-41d1-b112-e95b1e87724e

	measure 'COGS EUR' = SUM ( FactShipmentLine[DeliveredCostEUR] )
		formatString: #,0.00
		lineageTag: 76263184-53eb-48e8-8f14-665ee9094b7a

	measure 'Snapshot Days' = DISTINCTCOUNT ( FactInventorySnapshot[DateKey] )
		formatString: #,0
		lineageTag: 9e6893d9-32fe-442c-9288-13012d624ef3

	measure 'Inventory Turnover' =
			VAR Yrs = DIVIDE ( [Snapshot Days], 365 )
			RETURN
			    DIVIDE ( DIVIDE ( [COGS EUR], Yrs ), [Average Inventory Value EUR] )
		formatString: 0.00
		lineageTag: 309a0eb9-dbf8-43e3-a60e-be285512df8e

	measure 'Days of Inventory' = DIVIDE ( 365, [Inventory Turnover] )
		formatString: 0.0
		lineageTag: fd9a903d-32ce-4192-b034-9bde0551cbb3

	measure 'Stockout Rate %' =
			DIVIDE (
			    CALCULATE (
			        COUNTROWS ( FactInventorySnapshot ),
			        KEEPFILTERS ( FactInventorySnapshot[ClosingQty] = 0 )
			    ),
			    COUNTROWS ( FactInventorySnapshot )
			) * 100
		formatString: 0.00"%"
		lineageTag: e00d978e-3f9c-4be5-98eb-3d9ecee114b6

	measure 'OTIF % vs Target' =
			VAR A = [OTIF %]
			VAR T = LOOKUPVALUE ( DimTarget[TargetValue], DimTarget[KpiName], "OTIF %" )
			RETURN
			    IF (
			        NOT ISBLANK ( A ) && NOT ISBLANK ( T ),
			        "Target " & FORMAT ( T, "0.0" ) & "% · " & FORMAT ( A - T, "+0.0;-0.0;0.0" ) & " pp"
			    )
		lineageTag: 65ee827d-d2b0-5392-a52c-6368c7bdfbbd

	measure 'OTIF % Status Colour' =
			VAR A = [OTIF %]
			VAR T = LOOKUPVALUE ( DimTarget[TargetValue], DimTarget[KpiName], "OTIF %" )
			VAR D = LOOKUPVALUE ( DimTarget[Direction], DimTarget[KpiName], "OTIF %" )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( A ) || ISBLANK ( T ), BLANK (),
			        IF ( D = "lower", A <= T, A >= T ), "#2E7D32",
			        IF ( D = "lower", A <= T * 1.05, A >= T * 0.95 ), "#9C6500",
			        "#C62828"
			    )
		lineageTag: ddbae264-3c24-5539-a163-db195321f59b

