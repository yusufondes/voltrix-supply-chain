			RETURN
			    COUNTROWS ( FILTER ( VALUES ( FactPurchaseOrderLine[ProductKey] ), CALCULATE ( DISTINCTCOUNT ( FactPurchaseOrderLine[SupplierKey] ) ) = n ) ) + 0
