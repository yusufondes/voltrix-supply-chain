		lineageTag: 51ca187b-9bc3-5cf3-a6d2-8b22a0ee89b4

	measure 'At-Risk Revenue Share %' = DIVIDE ( [At-Risk Revenue EUR], [Delivered Revenue EUR] ) * 100
		formatString: 0.0"%"
		lineageTag: 5bafc500-71c9-58bd-88e5-a243bbf8fb68

	measure 'Supplier-Caused Failed Lines' =
			CALCULATE (
			    [Failed Lines],
			    FactSalesOrderLine[FailureReason] = "Supplier late",
			    USERELATIONSHIP ( FactSalesOrderLine[RootCauseSupplierKey], DimSupplier[SupplierKey] )
			)
		formatString: #,0
		lineageTag: d29215be-2eed-5bfa-958d-7d8fbad89af8

	measure 'Material-Caused Failed Lines' =
			CALCULATE (
			    [Failed Lines],
			    FactSalesOrderLine[FailureReason] = "Supplier late",
			    USERELATIONSHIP ( FactSalesOrderLine[RootCauseMaterialKey], DimMaterial[MaterialKey] )
			)
		formatString: #,0
		lineageTag: 80196b13-4c99-5385-9b06-3ffa3d0f4714

	measure 'Criticality Rank' =
			IF (
			    HASONEVALUE ( DimMaterial[MaterialName] ) && [Material Criticality] > 0,
			    RANKX (
			        FILTER ( ALLSELECTED ( DimMaterial[MaterialName] ), [Material Criticality] > 0 ),
			        [Material Criticality] * 1000000000 + [Dependent Revenue EUR],
			        ,
			        DESC,
			        Skip
			    )
			)
		formatString: 0
		isHidden
		lineageTag: c9fec90b-19f1-5caf-8bdd-db9f7813e0b6

	measure 'Supplier Late Rank' =
			IF (
			    HASONEVALUE ( DimSupplier[SupplierName] ) && [Supplier-Caused Failed Lines] > 0,
			    RANKX ( FILTER ( ALLSELECTED ( DimSupplier[SupplierName] ), [Supplier-Caused Failed Lines] > 0 ),
			            [Supplier-Caused Failed Lines], , DESC, Skip )
			)
		formatString: 0
		isHidden
		lineageTag: a966351f-df8c-575b-a74e-206596c1550d

	column Placeholder
		dataType: string
		isHidden
