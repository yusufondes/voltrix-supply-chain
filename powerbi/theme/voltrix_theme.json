      "color": "#003B73"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#1F2937"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D8E0E7"
              }
            }
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#003B73"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left",
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F5F9FC"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F5F9FC"
              }
            },
            "transparency": 0
          }
        ],
        "pageSize": [
          {
            "pageSizeTypes": "Custom",
            "pageSizeWidth": 1920,
            "pageSizeHeight": 1080
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#003B73"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "textSize": 10
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI",
            "textSize": 9
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#D8E0E7"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#D8E0E7"
              }
            },
            "outlineWeight": 1,
            "textSize": 9
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#003B73"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "backColorSecondary": {
              "solid": {
                "color": "#F5F9FC"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#1F2937"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#D8E0E7"
              }
            },
            "gridlineThickness": 1,
            "gridlineStyle": "solid"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "showTitle": false,
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            }
          }
        ],
        "labels": [
          {
            "show": false
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "$id": "default",
            "fontColor": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "label": [
          {
            "$id": "default",
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
