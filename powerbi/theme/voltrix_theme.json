            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#D8E0E7"
              }
            },
            "gridlineThickness": 1,
            "gridlineStyle": "solid"
          }
        ],
        "legend": [
          {
            "show": false
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "color": {
              "solid": {
                "color": "#1F2937"
              }
            }
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#D8E0E7"
              }
            },
            "gridlineThickness": 1,
            "gridlineStyle": "solid"
          }
        ],
        "legend": [
          {
            "show": false
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "color": {
              "solid": {
                "color": "#1F2937"
              }
            }
          }
        ]
      }
    }
  }
