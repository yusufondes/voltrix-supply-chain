{
  "name": "Voltrix Industrial",
  "dataColors": [
    "#005CA9",
    "#003B73",
    "#3E85BE",
    "#4F7FA3",
    "#2B4A63",
    "#5B7C99",
    "#6D879B",
    "#7C97AA"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#005CA9",
  "good": "#2E7D32",
  "neutral": "#9C6500",
  "bad": "#C62828",
  "maximum": "#003B73",
  "center": "#4F7FA3",
  "minimum": "#DCEFFC",
  "hyperlink": "#005CA9",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2937"
    },
    "title": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#003B73"
